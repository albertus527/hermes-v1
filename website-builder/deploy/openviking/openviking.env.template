# D4a.1 OpenViking environment file TEMPLATE (mode 0600 when installed).
#
# tools/openviking_provision.sh copies this to
# ~/.website-builder/openviking/openviking.env and fills in the two secrets.
# It is NEVER committed with real values, and it is OUTSIDE the git tree.
#
# The server config (~/.website-builder/openviking/ov.conf) references these by
# name; OpenViking's loader expands ${VAR} from the process environment, which
# the systemd EnvironmentFile supplies.

# Reused from the existing website credential. No new secret is invented.
NINEROUTER_API_KEY=
# Generated locally by the provision script; the application sends it as
# X-API-Key on every request. Rotate by editing this file and restarting.
OPENVIKING_ROOT_KEY=
