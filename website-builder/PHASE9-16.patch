+                           'name': provider.project['name'], 'target': 'production',
+                           'readyState': 'READY', 'meta': adapter._meta('app', 'op', 1, 'b' * 64)}
+    with store.acquire_writer('app') as state:
+        state.roles = {'owner': 'owner', 'reviewers': ['reviewer'], 'viewers': ['viewer']}
