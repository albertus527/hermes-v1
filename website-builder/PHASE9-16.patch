+            with patch("app.projects.build.QAOrchestrator") as mock_qa_cls:
+                mock_qa = MagicMock()
+                mock_qa.run.return_value = MagicMock(success=True, error=None)
+                mock_qa_cls.return_value = mock_qa
+                result = self.builder.build(project_id, brief)
