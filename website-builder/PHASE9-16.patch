++def digest(files):
++    h = hashlib.sha256()
++    for name, content in sorted(files.items()):
++        key = name.encode('utf-8')
++        h.update(len(key).to_bytes(8, 'big') + key)
++        h.update(len(content).to_bytes(8, 'big') + content)
++    return h.hexdigest()
